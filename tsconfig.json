{
  "compilerOptions": {
    "module": "esnext",
    "incremental": true,
    "moduleResolution": "bundler",
    "allowArbitraryExtensions": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "target": "es6",
    "strict": true,
    "jsx": "react",
    "lib": ["dom", "es2015.promise", "es6", "ES2020.Intl"],
    "baseUrl": ".",
    "noEmit": true,
    "noUnusedLocals": true,
    "paths": {
      "@fider/*": ["./public/*"],
      "@locale/*": ["./locale/*"],
      "e2e/*": ["./e2e/*"],
      "react/jsx-runtime.js": ["./node_modules/react/jsx-runtime.js"],
      "react/jsx-dev-runtime.js": ["./node_modules/react/jsx-dev-runtime.js"]
    }
  },
  "include": ["./public/**/*", "./locale/**/*", "index.d.ts", "./e2e/**/*"],
  "ts-node": {
    "esm": true,
    "experimentalSpecifierResolution": "node",
    "transpileOnly": true,
    "compilerOptions": {
      "module": "esnext"
    }
  }
}
