# Backend API Base URL (backend's own URL, not frontend URL)
BASE_URL=http://localhost:8080
GO_ENV=development
DATABASE_URL=postgres://fider:fider_pw@localhost:5555/fider?sslmode=disable

# JWT Authentication Configuration
# Secret key for signing JWT tokens (REQUIRED - generate a strong random string for production)
JWT_SECRET=hsjl]W;&ZcHxT&FK;s%bgIQF:#ch=~#Al4:5]N;7V<qPZ3e9lT4'%;go;LIkc%k
# Access token expiration in minutes (default: 15)
# JWT_ACCESS_TOKEN_EXPIRATION=15
# Refresh token expiration in days (default: 7)
# JWT_REFRESH_TOKEN_EXPIRATION=7
# Refresh token cookie name (default: fider_refresh_token)
# REFRESH_COOKIE_NAME=fider_refresh_token

# CORS Configuration for Cross-Origin SPA Communication
# Comma-separated list of allowed frontend origins (REQUIRED for production)
# NO wildcards (*) permitted in production environments
# Examples:
#   Development: http://localhost:5173,http://localhost:3000
#   Staging: https://app.staging.example.com,https://staging.example.com
#   Production: https://app.example.com,https://www.example.com
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
# Allowed HTTP methods for CORS requests
ALLOWED_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
# Allowed request headers for CORS requests
ALLOWED_HEADERS=Authorization,Content-Type,X-Tenant-ID
# Allow credentials (cookies, authorization headers) in CORS requests
CORS_ALLOW_CREDENTIALS=true
# Preflight cache duration in seconds (default: 600 = 10 minutes)
# CORS_MAX_AGE=600

# ALLOW_ALLOWED_SCHEMES=false

LOG_LEVEL=DEBUG
LOG_CONSOLE=true
LOG_SQL=true
LOG_FILE=false
LOG_FILE_OUTPUT=logs/output.log

# MAINTENANCE=true
# MAINTENANCE_MESSAGE=Sorry, we're down for scheduled maintenance right now.
# MAINTENANCE_UNTIL=about 5 AM PDT

OAUTH_FACEBOOK_APPID=
OAUTH_FACEBOOK_SECRET=

OAUTH_GOOGLE_CLIENTID=
OAUTH_GOOGLE_SECRET=

OAUTH_GITHUB_CLIENTID=
OAUTH_GITHUB_SECRET=

EMAIL_NOREPLY=noreply@yourdomain.com

#EMAIL_MAILGUN_API=
#EMAIL_MAILGUN_DOMAIN=
#EMAIL_MAILGUN_REGION=US

EMAIL_SMTP_HOST=localhost
EMAIL_SMTP_PORT=1025
EMAIL_SMTP_USERNAME=
EMAIL_SMTP_PASSWORD=
