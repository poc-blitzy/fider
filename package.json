{
  "name": "fider",
  "version": "0.0.0",
  "repository": "https://github.com/getfider/fider",
  "private": true,
  "dependencies": {
    "@lingui/format-json": "^5.1.2",
    "@lingui/react": "^5.1.2",
    "@tiptap/extension-hard-break": "^3.6.6",
    "@tiptap/extension-image": "^3.6.6",
    "@tiptap/extension-mention": "^3.6.6",
    "@tiptap/extension-placeholder": "^3.6.6",
    "@tiptap/pm": "^3.6.6",
    "@tiptap/react": "^3.6.6",
    "@tiptap/starter-kit": "^3.6.6",
    "@tiptap/suggestion": "^3.6.6",
    "@types/lodash": "^4.14.175",
    "dompurify": "^3.2.4",
    "inter-ui": "^4.1.0",
    "marked": "^4.0.15",
    "prosemirror-markdown": "^1.13.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-textarea-autosize": "^8.5.4",
    "react-toastify": "^9.0.1",
    "tiptap-markdown": "^0.9.0"
  },
  "devDependencies": {
    "@babel/cli": "^7.26.4",
    "@babel/core": "^7.26.0",
    "@babel/preset-env": "7.17.10",
    "@babel/preset-react": "7.16.7",
    "@babel/preset-typescript": "7.16.7",
    "@cucumber/cucumber": "8.2.0",
    "@cucumber/pretty-formatter": "^2.3.0",
    "@google-cloud/translate": "^9.1.0",
    "@lingui/babel-plugin-lingui-macro": "^5.1.2",
    "@lingui/cli": "^5.1.2",
    "@lingui/loader": "^5.1.2",
    "@lingui/macro": "^5.1.2",
    "@playwright/test": "1.48",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "5.16.4",
    "@testing-library/react": "^16.0.1",
    "@types/debug": "4.1.7",
    "@types/dompurify": "2.3.3",
    "@types/jsdom": "16.2.14",
    "@types/marked": "4.0.3",
    "@types/node": "^22.18.10",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/react-textarea-autosize": "4.3.6",
    "@typescript-eslint/eslint-plugin": "5.22.0",
    "@typescript-eslint/parser": "5.22.0",
    "autoprefixer": "10.4.7",
    "babel-jest": "28.1.0",
    "babel-loader": "8.2.5",
    "babel-plugin-macros": "3.1.0",
    "css-loader": "6.7.1",
    "esbuild": "0.25.0",
    "esbuild-plugin-babel": "0.2.3",
    "eslint": "8.15.0",
    "eslint-config-prettier": "8.5.0",
    "eslint-plugin-prettier": "4.0.0",
    "eslint-plugin-react": "7.29.4",
    "eslint-plugin-react-hooks": "4.5.0",
    "fork-ts-checker-webpack-plugin": "7.2.11",
    "isomorphic-fetch": "3.0.0",
    "jest": "28.1.0",
    "jest-environment-jsdom": "28.1.0",
    "mini-css-extract-plugin": "2.6.0",
    "prettier": "2.6.2",
    "purgecss-webpack-plugin": "4.1.3",
    "sass": "1.51.0",
    "sass-loader": "12.6.0",
    "svg-sprite-loader": "6.0.11",
    "svgo-loader": "3.0.0",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "webpack": "5.94.0",
    "webpack-bundle-analyzer": "4.5.0",
    "webpack-cli": "4.9.2"
  },
  "browserslist": ">1%, not dead",
  "jest": {
    "testEnvironment": "jsdom",
    "transform": {
      ".+\\.(tsx|ts)?$": "babel-jest"
    },
    "setupFilesAfterEnv": [
      "<rootDir>/public/jest.setup.tsx"
    ],
    "testRegex": "(/__tests__/.*|(\\.|/)(test|spec))\\.(ts|tsx|js|jsx)$",
    "moduleFileExtensions": [
      "ts",
      "tsx",
      "js",
      "jsx",
      "json",
      "node"
    ],
    "moduleNameMapper": {
      ".*\\.(png|scss|svg)$": "<rootDir>/public/jest.assets.ts",
      "@fider/(.*)": "<rootDir>/public/$1",
      "@locale/(.*)": "<rootDir>/locale/$1"
    }
  },
  "engines": {
    "npm": "10.x",
    "node": "21.x || 22.x"
  },
  "overrides": {
    "@types/markdown-it": "14.1.2"
  },
  "scripts": {
    "heroku-postbuild": "make build-ssr && make build-ui",
    "build:e2e": "tsc -p tsconfig.e2e.json",
    "test:e2e": "npm run build:e2e && npx cucumber-js --config cucumber.cjs",
    "test:e2e:cors": "npm run build:e2e && API_ONLY_TESTS=true npx cucumber-js --config cucumber.cjs --profile cors",
    "test:e2e:jwt": "npm run build:e2e && API_ONLY_TESTS=true npx cucumber-js --config cucumber.cjs --profile jwt",
    "test:e2e:api": "npm run build:e2e && API_ONLY_TESTS=true npx cucumber-js --config cucumber.cjs --profile api",
    "test:e2e:ci": "npm run build:e2e && npx cucumber-js --config cucumber.cjs --profile ci"
  }
}
