# Fider Frontend Environment Configuration
# Copy this file to .env and update the values for your environment.
# These variables are used at BUILD TIME by webpack DefinePlugin.

# Base URL of the Fider Backend API server
# This is injected at build time into the SPA bundle as __FIDER_CONFIG__.apiHost
# Use empty string or omit for same-origin deployments
FIDER_PUBLIC_API_BASE_URL=http://localhost:3000
